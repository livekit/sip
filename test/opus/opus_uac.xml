&lt;!--
SIPp UAC scenario: sends INVITE with Opus SDP offer.
Usage: sipp -sf opus_uac.xml -s +000000000 <sip_server_ip>:<port>
--&gt;
&lt;scenario name="Opus UAC"&gt;
  &lt;send retrans="500"&gt;
    &lt;![CDATA[
      INVITE sip:[service]@[remote_ip]:[remote_port] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
      From: "SIPp Opus" &lt;sip:[local_ip]:[local_port]&gt;;tag=[call_number]
      To: &lt;sip:[service]@[remote_ip]:[remote_port]&gt;
      Call-ID: [call_id]
      CSeq: 1 INVITE
      Contact: &lt;sip:[local_ip]:[local_port];transport=[transport]&gt;
      Max-Forwards: 70
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=- [call_number] [call_number] IN IP[local_ip_type] [local_ip]
      s=SIPp Opus Test
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 96 101
      a=rtpmap:96 opus/48000/2
      a=fmtp:96 stereo=0;sprop-stereo=0;useinbandfec=1
      a=rtpmap:101 telephone-event/8000
      a=fmtp:101 0-16
      a=ptime:20
      a=sendrecv
    ]]&gt;
  &lt;/send&gt;

  &lt;recv response="100" optional="true" /&gt;
  &lt;recv response="180" optional="true" /&gt;
  &lt;recv response="183" optional="true" /&gt;

  &lt;recv response="200" rtd="true"&gt;
    &lt;action&gt;
      &lt;ereg regexp="Content-Length: ([0-9]+)"
            search_in="hdr"
            check_it="true"
            assign_to="cl" /&gt;
      &lt;exec play_pcap_audio="opus_ref.pcap" /&gt;
    &lt;/action&gt;
  &lt;/recv&gt;

  &lt;send&gt;
    &lt;![CDATA[
      ACK [next_url] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
      From: "SIPp Opus" &lt;sip:[local_ip]:[local_port]&gt;;tag=[call_number]
      To: &lt;sip:[service]@[remote_ip]:[remote_port]&gt;[peer_tag_param]
      Call-ID: [call_id]
      CSeq: 1 ACK
      Contact: &lt;sip:[local_ip]:[local_port];transport=[transport]&gt;
      Max-Forwards: 70
      Content-Length: 0
    ]]&gt;
  &lt;/send&gt;

  &lt;!-- Keep call alive for specified duration --&gt;
  &lt;pause milliseconds="3000" /&gt;

  &lt;send retrans="500"&gt;
    &lt;![CDATA[
      BYE [next_url] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
      From: "SIPp Opus" &lt;sip:[local_ip]:[local_port]&gt;;tag=[call_number]
      To: &lt;sip:[service]@[remote_ip]:[remote_port]&gt;[peer_tag_param]
      Call-ID: [call_id]
      CSeq: 2 BYE
      Contact: &lt;sip:[local_ip]:[local_port];transport=[transport]&gt;
      Max-Forwards: 70
      Content-Length: 0
    ]]&gt;
  &lt;/send&gt;

  &lt;recv response="200" crlf="true" /&gt;

  &lt;!-- Definition of response time repartition --&gt;
  &lt;ResponseTimeRepartition value="100, 200, 400, 800, 1500" /&gt;
  &lt;CallLengthRepartition value="1000, 5000, 10000, 30000" /&gt;
&lt;/scenario&gt;